# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://forexai:PASSWORD@db:5432/forexai
POSTGRES_USER=forexai
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=forexai

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
ADMIN_PASSWORD=your-admin-password-here

# ── OANDA (Market Data & Auto-Trading) ────────────────────────────────────────
OANDA_API_KEY=your-oanda-api-key
OANDA_ACCOUNT_ID=your-oanda-account-id
OANDA_BASE_URL=https://api-fxpractice.oanda.com
# For live trading: https://api-fxtrade.oanda.com

# ── Stripe (Payments) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_VIP_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx

# ── Telegram (Signal Alerts) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHANNEL_ID=@alphaforexai

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=mail.alphaforexai.com
SMTP_PORT=465
SMTP_USER=alerts@alphaforexai.com
SMTP_PASSWORD=your-email-password

# ── Signal Settings ───────────────────────────────────────────────────────────
SIGNAL_CONFIDENCE_THRESHOLD=0.58
TP_PIPS=15
SL_PIPS=10
ACTIVE_PAIRS=["EUR_USD","GBP_USD","USD_JPY","XAU_USD"]
ACTIVE_TIMEFRAME=H1

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
